# API boshqa public origin'da bo'lsa kiriting; odatda Next proxy yetarli.
NEXT_PUBLIC_API_BASE=/api/v1

# Yandex JavaScript API v3 kaliti. Developer kabinetida HTTP Referer
# cheklovi sifatida localhost, staging va production domenlarini kiriting.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your_yandex_javascript_api_key
