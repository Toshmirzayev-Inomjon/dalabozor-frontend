# API boshqa public origin'da bo'lsa kiriting; odatda Next proxy yetarli.
NEXT_PUBLIC_API_BASE=/api/v1

# Backend origin (server-side rewrite uchun). Kodda default:
# https://dalabozor-backend.up.railway.app — Vercel/ushbu default ishlaydi.
# Lokal ishlab chiqishda shu faylda (local) BACKEND_ORIGIN=http://127.0.0.1:8099
BACKEND_ORIGIN=https://dalabozor-backend.up.railway.app

# Yandex JavaScript API v3 kaliti. Developer kabinetida HTTP Referer
# cheklovi sifatida localhost, staging va production domenlarini kiriting.
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=your_yandex_javascript_api_key
